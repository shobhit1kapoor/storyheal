# Copy to .env and replace every value marked CHANGE_ME.
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
POSTGRES_DB=storyheal
POSTGRES_USER=storyheal
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
RAG_INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY
INTERNAL_SERVICE_API_KEY=CHANGE_ME_AI_INTERNAL_SERVICE_KEY

# Public deployment
PUBLIC_HOST=support.example.com
HTTP_PORT=80
HTTPS_PORT=443
VITE_API_BASE_URL=/api
VITE_WIDGET_PREVIEW_URL=/widget/
VITE_WIDGET_SCRIPT_BASE=/widget/storyheal-widget-sdk.js
WK_EXTERNAL_WSADDR=
WK_EXTERNAL_WSSADDR=wss://support.example.com/wss

# Free/local model defaults. Start Compose with --profile local-ai.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_DIMENSIONS=1536

# Optional OpenAI-compatible replacement
# OLLAMA_BASE_URL=https://your-compatible-host
# EMBEDDING_BASE_URL=https://your-compatible-host/v1
# EMBEDDING_API_KEY=CHANGE_ME

# Storyblok credentials are intentionally absent. Configure them through the
# encrypted StoryHeal integration wizard; they are never frontend environment variables.

LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=43200
MAX_UPLOAD_SIZE_MB=20
